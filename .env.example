# Local Docker demo only. Copy to .env; never commit the generated .env.
DOCKER_DEMO_PORT=8080

# REQUIRED: generate a fresh random value of at least 32 characters.
# Keep the same value across restarts to preserve CSRF/session validity.
V2_SECRET_KEY=

# Only for the synthetic demo database: the Docker demo seeds a fresh synthetic DB in its own
# demo_data volume, so analytics (Integrity Index, recommendations, comparisons) are enabled.
# Set 0 for any other database; the flag does not verify where the data came from.
INTEGRITY_ANALYTICS_DEMO=1

# The Docker frontend uses same-origin /api and /v2; do not set a localhost API URL.
VITE_API_BASE_URL=

# Only for standalone Vite development; Docker build excludes .env.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# --- Backend V2 (release) — значення секретів тут НЕ зберігати ---
# APP_ENV=release
# V2_SECRET_KEY=            # ≥ 32 символи; лише в захищеній конфігурації служби
# TRUSTED_PROXIES=127.0.0.1,::1   # у release обов'язкове (Caddy на тому ж хості)
# FRONTEND_ORIGINS=https://<host>
# V2_MAX_BODY_BYTES=65536   # 413 для більших тіл; узгоджено з request_body у Caddy
# V2_SMTP_HOST= / V2_SMTP_PORT=587 / V2_SMTP_USER= / V2_SMTP_PASSWORD=
# V2_SMTP_FROM=             # у release обов'язкове, якщо задано V2_SMTP_HOST
# V2_SMTP_TLS_MODE=starttls # starttls (587) або implicit (465); сертифікат і hostname перевіряються завжди
# Локальна ШІ для чернеток звітів (docs/LOCAL_LM.md); не задано V2_LM_URL → функцію вимкнено
# V2_LM_URL=http://127.0.0.1:8200   # у release лише loopback (127.0.0.1, ::1, localhost)
# V2_LM_API_KEY=            # необов'язково: той самий ключ, що --api-key llama-server; лише в захищеній конфігурації
# V2_LM_MODEL=qwen3-8b      # ім'я моделі в запиті
# V2_LM_TIMEOUT_S=300       # таймаут одного запиту генерації, с
# V2_LM_MAX_TOKENS=900      # верхня межа токенів відповіді
# У release заборонено: INTEGRITY_DEMO_XROLE=1, V2_AUTH_DEV_MAIL=1, V2_AUTH_SECURE_COOKIE=0, V2_CATALOG_NOW

# --- Local LM (docker compose --profile lm; docs/LOCAL_LM.md) ---
# LM_THREADS=4                 # llama-server -t; <= physical cores given to Docker
# LM_MEM_LIMIT=8g              # container memory limit (model ~5 GB + KV cache 8192 ~1.2 GB)
# LM_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b12180   # or @sha256:<digest> after docker pull
# V2_LM_URL=http://lm:8080     # backend -> LM inside compose (default)
