# Local Docker demo only. Copy to .env; never commit the generated .env.
DOCKER_DEMO_PORT=8080

# REQUIRED: generate a fresh random value of at least 32 characters.
# Keep the same value across restarts to preserve CSRF/session validity.
V2_SECRET_KEY=

# Only for the synthetic demo database: the Docker demo seeds a fresh synthetic DB in its own
# demo_data volume, so analytics (Integrity Index, recommendations, comparisons) are enabled.
# Set 0 for any other database; the flag does not verify where the data came from.
INTEGRITY_ANALYTICS_DEMO=1

# The Docker frontend uses same-origin /api and /v2; do not set a localhost API URL.
VITE_API_BASE_URL=

# Only for standalone Vite development; Docker build excludes .env.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
